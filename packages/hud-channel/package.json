{
  "name": "@open-neko/channel-hud",
  "version": "0.2.0",
  "description": "Bidirectional signed HUD channel for OpenNeko demo packs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-neko/plugins.git",
    "directory": "packages/hud-channel"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "openneko": {
    "runner": "./dist/run.js",
    "permissions": {
      "network": [
        "demo-channel"
      ],
      "env": [
        {
          "key": "HUD_CHANNEL_SECRET",
          "required": true,
          "secret": true,
          "inject": "box",
          "description": "HMAC secret shared with the selected demo pack's HUD bridge. Generated by the demo-pack installer."
        },
        {
          "key": "HUD_CHANNEL_WORKSPACE",
          "required": false,
          "secret": false,
          "description": "Stable pack identifier used for inbound sender and recipient scoping."
        }
      ]
    },
    "capabilities": {
      "channel": {
        "providerLabel": "HUD surface",
        "directions": [
          "outbound",
          "inbound"
        ],
        "ingress": "webhook",
        "profile": {
          "modalities": [
            "text",
            "visual"
          ],
          "richMedia": {
            "markdown": true,
            "cards": true,
            "charts": true,
            "images": true,
            "interactiveControls": true
          },
          "interaction": {
            "turnTaking": "async",
            "canApproveInline": true,
            "quickReplies": true
          },
          "constraints": {
            "latencyClass": "interactive",
            "attentionModel": "push"
          },
          "fidelity": "full"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@open-neko/plugin-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
